# Production defaults for the Moto -> cup tunnel.
# The cup setup script writes a filled-in copy. Install that file at
# /data/adb/phonetunnel/config.env (mode 600). Lines are KEY=value.
# Values may contain only letters, digits, and . _ : / @ -

CUP_HOST=62.83.35.197
CUP_PORT=22
CUP_USER=phonetunnel
KEEPALIVE_SEC=45
BACKOFF_INITIAL_SEC=2
BACKOFF_MAX_SEC=60
# cup localhost ports (remote side of ssh -R)
SSH_REMOTE_PORT=2222
ADB_REMOTE_PORT=5556
# phone localhost ports
PHONE_SSH_PORT=2222
PHONE_ADB_PORT=5555
TS_PACKAGE=com.tailscale.ipn
TS_ACTIVITY=com.tailscale.ipn/com.tailscale.ipn.IPNActivity
TS_CHECK_SEC=60
TS_DOWN_STREAK=3
TS_RESTART_MIN_SEC=900
