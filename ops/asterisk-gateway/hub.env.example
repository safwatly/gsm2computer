# Example only. Do not install this file onto cup from git.
# Put the values in the gsm2computer-hub.service override the operator already
# uses, then restart with hub/ops/cutover.sh while the line is idle.
# Leave GSM2COMPUTER_ASTERISK_GATEWAY unset until the Pi answers AMI.
# The secret is the one install.sh wrote on the Pi at /etc/gsm2computer/ami.secret.

GSM2COMPUTER_ASTERISK_GATEWAY=1
GSM2COMPUTER_ASTERISK_AMI_HOST=
GSM2COMPUTER_ASTERISK_AMI_PORT=5038
GSM2COMPUTER_ASTERISK_AMI_USER=gsm-gateway
GSM2COMPUTER_ASTERISK_AMI_SECRET=
GSM2COMPUTER_ASTERISK_DEVICE=ec25
GSM2COMPUTER_ASTERISK_AUDIOSOCKET_PORT=9092
