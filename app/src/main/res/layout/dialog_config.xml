<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hub endpoints, one per line. First that answers is used. Blank uses the public entrance, then Tailscale."
        android:textSize="12sp"
        android:paddingBottom="4dp" />

    <EditText
        android:id="@+id/etHubEndpoints"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:hint="wss://gsm.ta3leam.com/&#10;ws://100.113.222.47:8787/"
        android:inputType="textMultiLine|textUri"
        android:minLines="2"
        android:importantForAutofill="no" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Device token (X-Gsm-Device-Token). Leave blank to keep the saved token."
        android:textSize="12sp"
        android:paddingBottom="4dp" />

    <EditText
        android:id="@+id/etDeviceToken"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="unchanged if blank"
        android:inputType="textPassword"
        android:importantForAutofill="no" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Hub control URL (legacy single host; also written from the first endpoint)"
        android:textSize="12sp"
        android:paddingBottom="4dp" />

    <EditText
        android:id="@+id/etHubControlUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="http://hub.mining-ling.ts.net:8787"
        android:inputType="textUri"
        android:importantForAutofill="no" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Token URL (optional; defaults to {hub}/token)"
        android:textSize="12sp"
        android:paddingBottom="4dp" />

    <EditText
        android:id="@+id/etStreamTokenUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="http://hub.mining-ling.ts.net:8787/token"
        android:inputType="textUri"
        android:importantForAutofill="no" />

    <EditText
        android:id="@+id/etStreamModel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Model (OpenAI only)"
        android:inputType="text"
        android:importantForAutofill="no" />

    <EditText
        android:id="@+id/etStreamVoice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Voice (OpenAI only)"
        android:inputType="text"
        android:importantForAutofill="no" />

    <CheckBox
        android:id="@+id/cbAutoconnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Start bridge automatically on boot" />

    <Button
        android:id="@+id/btnLoadConfig"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Load from file" />

</LinearLayout>
