# gsm2computer public-interface filter.
# This file only replaces table inet gsm2computer. It must never flush the
# host ruleset. Non-public interfaces (lo, tailscale0, docker) match the first
# rule and are left alone, so RustDesk on tailscale0 stays reachable.
# On the public NIC everything else is dropped, including RustDesk
# tcp/21118 and tcp/udp 21125-21129.

table inet gsm2computer {
	chain input {
		type filter hook input priority filter + 10; policy accept;
		iifname != "__PUBLIC_IF__" accept comment "tailscale0 and other interfaces stay open"
		ct state established,related accept comment "keep the SSH session that applied this"
		ct state invalid drop
		tcp dport __SSH_PORT__ accept comment "break-glass ssh"
		tcp dport __TLS_PORT__ accept comment "public tls audio entrance"
		udp dport __TS_PORT__ accept comment "tailscale wireguard"
		ip protocol icmp icmp type { destination-unreachable, time-exceeded } accept comment "pmtu"
		meta l4proto icmpv6 icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit, nd-router-advert } accept comment "pmtu6-and-nd"
		tcp dport { 21118, 21125-21129 } counter drop comment "rustdesk-not-public"
		udp dport { 21118, 21125-21129 } counter drop comment "rustdesk-not-public"
		counter drop comment "default deny on the public interface"
	}
}
