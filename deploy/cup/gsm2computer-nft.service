[Unit]
Description=gsm2computer public TLS rule in the existing inet filter
After=nftables.service
Before=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/gsm2computer-nft.sh boot
# No ExecStop. Stopping this unit must not flush nftables or delete the
# host filter. gsm2computer-nft.sh revert removes only the TCP 443 rule.

[Install]
WantedBy=multi-user.target
