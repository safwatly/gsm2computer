# Copy to /etc/gsm2computer/public-entrance.env and fill in.
# No secrets belong in this file. The device token lives in the hub user's
# ~/.config/gsm2computer/device-tokens.json (mode 0600).

# Grey-cloud A record to 62.83.35.197. Not a name this repo already had.
GSM2COMPUTER_PUBLIC_HOSTNAME=gsm.ta3leam.com
# Address Caddy binds for :443, including the TLS-ALPN challenge.
# The public IP only. Never 0.0.0.0 or empty: Tailscale Serve already listens
# on the tailnet address :443.
GSM2COMPUTER_PUBLIC_BIND=62.83.35.197
# Let's Encrypt account email. Required. Caddy will not start if this is empty.
GSM2COMPUTER_ACME_EMAIL=
GSM2COMPUTER_PUBLIC_UPSTREAM=127.0.0.1:8790
